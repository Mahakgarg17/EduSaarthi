<%- include('partials/header', { pageTitle: (lang === 'hi') ? course.title_hi : course.title }) %>
<%- include('partials/navbar', { activeTab: 'learn' }) %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/learn" style="font-size: 0.9rem; font-weight: 600; color: var(--primary-light); display: inline-flex; align-items: center; gap: 0.35rem;">
      ← <%= (lang === 'hi') ? 'सभी विषयों पर वापस जाएं' : 'Back to all courses' %>
    </a>
  </div>

  <!-- Course Hero Banner -->
  <div class="card" style="background: linear-gradient(135deg, <%= course.color %> 0%, #1E3A8A 100%); color: white; margin-bottom: 2rem; padding: 2.25rem;">
    <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
      <span class="badge" style="background: rgba(255,255,255,0.2); color: white;"><%= course.education_level %></span>
      <span class="badge" style="background: rgba(255,255,255,0.2); color: white;"><%= course.category %></span>
    </div>
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.75rem;">
      <%= (lang === 'hi') ? course.title_hi : course.title %>
    </h1>
    <p style="font-size: 1.05rem; opacity: 0.9; max-width: 800px; line-height: 1.6;">
      <%= (lang === 'hi') ? course.description_hi : course.description %>
    </p>
  </div>

  <!-- Lessons List -->
  <div style="margin-bottom: 1.5rem;">
    <h2 style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); margin-bottom: 1rem;">
      <%= (lang === 'hi') ? 'पाठ सूची (Syllabus Lessons)' : 'Course Syllabus' %>
    </h2>
  </div>

  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <% lessons.forEach(lesson => { %>
      <% 
        const isDone = userProgress && userProgress[lesson.id] && userProgress[lesson.id].completed;
      %>
      <div class="card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding: 1.25rem 1.5rem;">
        <div style="display: flex; align-items: center; gap: 1.25rem;">
          <div style="width: 2.5rem; height: 2.5rem; border-radius: 50%; background: <%= isDone ? '#D1FAE5' : '#EFF6FF' %>; color: <%= isDone ? '#065F46' : 'var(--primary)' %>; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1rem; flex-shrink: 0;">
            <%= isDone ? '✓' : lesson.order_index %>
          </div>
          <div>
            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--text-main);">
              <%= (lang === 'hi') ? lesson.title_hi : lesson.title %>
            </h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.4; max-width: 650px;">
              <%= (lang === 'hi') ? lesson.summary_hi : lesson.summary %>
            </p>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <% if (isDone) { %>
            <span class="badge badge-success"><%= (lang === 'hi') ? 'पूर्ण' : 'Completed' %></span>
          <% } %>
          <a href="/learn/lesson/<%= lesson.id %>" class="btn btn-sm btn-primary">
            <%= (lang === 'hi') ? 'पाठ पढ़ें →' : 'Study Lesson →' %>
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</main>

<%- include('partials/footer') %>
