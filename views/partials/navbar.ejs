<!-- Persistent Top Status Bar -->
<div class="top-status-bar" role="region" aria-label="System Connectivity and Preferences">
  <div class="container top-status-inner">
    <div class="status-left">
      <span class="status-badge" id="lang-status-pill">
        🌐 <%= typeof currentLanguage !== 'undefined' ? currentLanguage.label + ' (' + currentLanguage.name + ')' : 'हिन्दी (Hindi)' %>
      </span>
      <span class="status-badge <%= (typeof lowData !== 'undefined' && lowData) ? 'low-data-active' : '' %>" id="low-data-status-pill">
        📶 <%= (typeof lowData !== 'undefined' && lowData) ? t('lowDataOn') : t('lowDataOff') %>
      </span>
    </div>
    <div class="status-right">
      <span class="status-badge online" id="network-status-pill">
        ✓ <%= t('onlineStatus') %>
      </span>
    </div>
  </div>
</div>

<!-- Offline Notification Banner -->
<div class="offline-banner" id="offline-banner" role="alert">
  ⚠️ <%= t('offlineBanner') %>
</div>

<!-- Main Global Navigation Bar -->
<header class="navbar" role="banner">
  <div class="container navbar-inner">
    <!-- Brand Logo -->
    <a href="<%= user ? '/dashboard' : '/' %>" class="brand" aria-label="EduSaarthi Home">
      <div class="brand-icon" aria-hidden="true">ES</div>
      <div class="brand-text">
        <span class="brand-title"><%= t('siteName') %></span>
        <span class="brand-tagline"><%= t('tagline') %></span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav aria-label="Main Navigation">
      <ul class="nav-links" id="nav-links">
        <li><a href="/" class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'home') ? 'active' : '' %>"><%= t('navHome') %></a></li>
        <% if (user) { %>
          <li><a href="/dashboard" class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'dashboard') ? 'active' : '' %>"><%= t('navDashboard') %></a></li>
        <% } %>
        <li><a href="/learn" class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'learn') ? 'active' : '' %>"><%= t('navLearn') %></a></li>
        <li><a href="/tutor" class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'tutor') ? 'active' : '' %>">🤖 <%= t('navTutor') %></a></li>
        <li><a href="/scholarships" class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'scholarships') ? 'active' : '' %>">🎓 <%= t('navScholarships') %></a></li>
        <li><a href="/career" class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'career') ? 'active' : '' %>">🧭 <%= t('navCareer') %></a></li>
        <li><a href="/mentors" class="nav-link <%= (typeof activeTab !== 'undefined' && activeTab === 'mentors') ? 'active' : '' %>">👨‍🏫 <%= t('navMentors') %></a></li>
      </ul>
    </nav>

    <!-- Controls (Multilingual Selector, Low Data, User Profile) -->
    <div class="nav-controls">
      <!-- Low Data Mode Toggle -->
      <button type="button" class="toggle-control <%= (typeof lowData !== 'undefined' && lowData) ? 'active' : '' %>" id="low-data-toggle" aria-pressed="<%= (typeof lowData !== 'undefined' && lowData) ? 'true' : 'false' %>" title="Reduces heavy images and animations">
        <span>📶</span>
        <span class="toggle-text"><%= (typeof lowData !== 'undefined' && lowData) ? t('lowDataOn') : t('lowDataOff') %></span>
      </button>

      <!-- Multilingual Language Selector -->
      <div class="lang-select-wrapper" title="Select Regional Language">
        <span class="lang-icon" aria-hidden="true">🌐</span>
        <select id="lang-select" class="lang-select" aria-label="Select Language">
          <% if (typeof supportedLanguages !== 'undefined') { %>
            <% supportedLanguages.forEach(l => { %>
              <option value="<%= l.code %>" <%= (lang === l.code) ? 'selected' : '' %>>
                <%= l.label %> (<%= l.name %>)
              </option>
            <% }); %>
          <% } else { %>
            <option value="hi" <%= lang === 'hi' ? 'selected' : '' %>>हिन्दी (Hindi)</option>
            <option value="en" <%= lang === 'en' ? 'selected' : '' %>>English</option>
          <% } %>
        </select>
      </div>

      <!-- User Authentication State -->
      <% if (user) { %>
        <div class="user-chip" title="<%= user.email %>">
          <div class="user-avatar-mini"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></div>
          <span class="user-name-short"><%= user.name ? user.name.split(' ')[0] : 'Student' %></span>
          <a href="/auth/logout" class="btn btn-sm btn-secondary" style="padding: 0.2rem 0.5rem; margin-left: 0.25rem;" title="<%= t('navLogout') %>">✕</a>
        </div>
      <% } else { %>
        <a href="/auth/login" class="btn btn-sm btn-outline-primary"><%= t('navLogin') %></a>
        <a href="/auth/register" class="btn btn-sm btn-primary"><%= t('navRegister') %></a>
      <% } %>

      <!-- Mobile Hamburger Button -->
      <button type="button" class="hamburger-btn" id="hamburger-btn" aria-label="Toggle navigation menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>
