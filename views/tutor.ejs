<%- include('partials/header', { pageTitle: (lang === 'hi') ? 'एआई ट्यूटर' : 'AI Tutor' }) %>
<%- include('partials/navbar', { activeTab: 'tutor' }) %>

<main class="container" style="padding-top: 1rem; padding-bottom: 2rem;">
  <div class="tutor-container">
    <!-- Chat Header -->
    <div class="tutor-header">
      <div class="tutor-info">
        <h3>
          <span style="font-size: 1.4rem;">🤖</span>
          <span>EduSaarthi AI Tutor</span>
          <span class="badge badge-success" style="font-size: 0.7rem; margin-left: 0.5rem;">Adaptive 2.0</span>
        </h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">
          <%= t('tagline') %>
        </p>
      </div>

      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <button type="button" class="btn btn-sm btn-secondary" id="stop-tts-global-btn" onclick="window.EduVoice && window.EduVoice.stopSpeaking()" title="Stop audio speech">
          ⏹ <%= (lang === 'hi') ? 'आवाज़ रोकें' : 'Stop Audio' %>
        </button>
        <span class="badge badge-slate" id="chat-lang-indicator">
          🌐 <%= typeof currentLanguage !== 'undefined' ? currentLanguage.label : 'हिन्दी' %>
        </span>
      </div>
    </div>

    <!-- Chat Messages Scroll Area -->
    <div class="chat-messages" id="chat-messages" role="log" aria-live="polite">
      <!-- Welcome Message from AI -->
      <div class="chat-bubble ai">
        <div class="msg-header">
          <strong>EduSaarthi AI</strong>
          <button type="button" class="read-aloud-btn" onclick="readBubbleText(this)">
            🔊 <%= t('readAloud') %>
          </button>
        </div>
        <div class="bubble-text">
          <% if (lang === 'hi') { %>
            नमस्ते! 👋 मैं आपका एडू-सारथी एआई ट्यूटर हूँ। विज्ञान, गणित, अंग्रेज़ी या किसी भी विषय में जो बात समझ न आई हो, बेझिझक पूछें। आप बोलकर (माइक) या लिखकर सवाल कर सकते हैं।
          <% } else if (lang === 'bn') { %>
            নমস্কার! 👋 আমি আপনার এডু-সারথী এআই শিক্ষক। বিজ্ঞান, অঙ্ক, ইংরেজি বা যেকোনো বিষয়ে আপনার প্রশ্ন নিঃসংকোচে জিজ্ঞাসা করুন।
          <% } else if (lang === 'or') { %>
            ନମସ୍କାର! 👋 ମୁଁ ଆପଣଙ୍କର ଏଡୁ-ସାରଥି ଏଆଇ ଶିକ୍ଷକ। ବିଜ୍ଞାନ, ଗଣିତ, ଇଂରାଜୀ କିମ୍ବା ଯେକୌଣସି ବିଷୟରେ ଆପଣଙ୍କର ସନ୍ଦେହ ପଚାରନ୍ତୁ।
          <% } else if (lang === 'te') { %>
            నమస్కారం! 👋 నేను మీ ఎడ్యుసారథి AI ట్యూటర్‌ను. సైన్స్, మ్యాథ్స్ లేదా ఏదైనా సబ్జెక్టులో మీ సందేహాలను అడగండి.
          <% } else if (lang === 'mr') { %>
            नमस्कार! 👋 मी तुमचा एड्यू-सारथी एआय ट्यूटर आहे. विज्ञान, गणित किंवा इतर कोणत्याही विषयातील शंका बिनधास्त विचारा.
          <% } else if (lang === 'gu') { %>
            નમસ્તે! 👋 હું તમારો એડ્યુ-સારથી AI શિક્ષક છું. વિજ્ઞાન, ગણિત અથવા કોઈપણ વિષયમાં પ્રશ્ન પૂછો.
          <% } else if (lang === 'ta') { %>
            வணக்கம்! 👋 நான் உங்கள் எடு-சாரதி AI ஆசிரியர். அறிவியல், கணிதம் அல்லது எந்தப் பாடத்திலும் உங்கள் சந்தேகங்களைக் கேளுங்கள்.
          <% } else { %>
            Hello! 👋 I am your EduSaarthi AI Tutor. Ask me any concept in Science, Math, English, or Social Studies. You can type or use the microphone button to ask questions in your own words.
          <% } %>
        </div>
      </div>
    </div>

    <!-- Suggested Question Chips -->
    <div class="prompt-chips-wrap">
      <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); align-self: center; margin-right: 0.25rem;">
        <%= t('suggested') %>
      </span>

      <% if (lang === 'bn') { %>
        <button type="button" class="chip-btn" data-query="সালোকসংশ্লেষ কী? সহজ ভাষায় বুঝিয়ে দাও।">
          🌿 সালোকসংশ্লেষ কী?
        </button>
        <button type="button" class="chip-btn" data-query="আকাশ নীল দেখায় কেন?">
          🌤️ আকাশ নীল কেন?
        </button>
        <button type="button" class="chip-btn" data-query="নিউটনের তৃতীয় গতিসূত্র কী?">
          🍎 নিউটনের তৃতীয় সূত্র
        </button>
      <% } else if (lang === 'or') { %>
        <button type="button" class="chip-btn" data-query="ଆଲୋକ ଶ୍ଳେଷଣ କ'ଣ? ସରଳ ଭାଷାରେ ବୁଝାନ୍ତୁ।">
          🌿 ଆଲୋକ ଶ୍ଳେଷଣ କ'ଣ?
        </button>
        <button type="button" class="chip-btn" data-query="ଆକାଶ ନୀଳ କାହିଁକି ଦେଖାଯାଏ?">
          🌤️ ଆକାଶ ନୀଳ କାହିଁକି?
        </button>
        <button type="button" class="chip-btn" data-query="ନ୍ୟୁଟନଙ୍କ ତୃତୀୟ ଗତି ନିୟମ କ'ଣ?">
          🍎 ନ୍ୟୁଟନଙ୍କ ତୃତୀୟ ନିୟମ
        </button>
      <% } else if (lang === 'te') { %>
        <button type="button" class="chip-btn" data-query="కిరణజన్య సంయోగక్రియ అంటే ఏమిటి? సులభంగా వివరించండి.">
          🌿 కిరణజన్య సంయోగక్రియ?
        </button>
        <button type="button" class="chip-btn" data-query="ఆకాశం నీలంగా ఎందుకు కనిపిస్తుంది?">
          🌤️ ఆకాశం నీలం ఎందుకు?
        </button>
        <button type="button" class="chip-btn" data-query="న్యూటన్ మూడవ చలన సూత్రం ఏమిటి?">
          🍎 న్యూటన్ మూడవ సూత్రం
        </button>
      <% } else if (lang === 'mr') { %>
        <button type="button" class="chip-btn" data-query="प्रकाशसंश्लेषण म्हणजे काय? सोप्या भाषेत समजावून सांगा.">
          🌿 प्रकाशसंश्लेषण म्हणजे काय?
        </button>
        <button type="button" class="chip-btn" data-query="आकाश निळे का दिसते?">
          🌤️ आकाश निळे का दिसते?
        </button>
        <button type="button" class="chip-btn" data-query="न्यूटनचा तिसरा गतीचा नियम काय आहे?">
          🍎 न्यूटनचा तिसरा नियम
        </button>
      <% } else if (lang === 'hi') { %>
        <button type="button" class="chip-btn" data-query="प्रकाश संश्लेषण क्या है? इसे आसान भाषा में समझाओ।">
          🌿 प्रकाश संश्लेषण क्या है?
        </button>
        <button type="button" class="chip-btn" data-query="आकाश का रंग नीला क्यों दिखाई देता है?">
          🌤️ आकाश नीला क्यों है?
        </button>
        <button type="button" class="chip-btn" data-query="न्यूटन का तीसरा गति नियम क्या है?">
          🍎 न्यूटन का तीसरा नियम
        </button>
      <% } else { %>
        <button type="button" class="chip-btn" data-query="Explain photosynthesis simply">
          🌿 Explain photosynthesis simply
        </button>
        <button type="button" class="chip-btn" data-query="Why is the sky blue?">
          🌤️ Why is the sky blue?
        </button>
        <button type="button" class="chip-btn" data-query="Explain Newton's third law">
          🍎 Newton's third law
        </button>
      <% } %>
      <button type="button" class="chip-btn" data-query="<%= (lang === 'hi') ? 'गणित के कठिन प्रश्न हल करने का तरीका समझाओ' : 'Help me solve this math problem' %>">
        📐 <%= (lang === 'hi') ? 'गणित का सवाल कैसे हल करें?' : 'Help me solve math problem' %>
      </button>
    </div>

    <!-- Quick Action Helper Prompts Bar -->
    <div class="tutor-quick-actions-bar" aria-label="Quick Prompt Shortcuts">
      <button type="button" class="quick-prompt-action" data-prompt="<%= (lang === 'hi') ? 'कृपया इसे और सरल व आसान भाषा में समझाएं।' : 'Please explain this concept simply with basic words.' %>">
        💡 <%= (lang === 'hi') ? 'सरल भाषा में समझाओ' : 'Explain this simply' %>
      </button>
      <button type="button" class="quick-prompt-action" data-prompt="<%= (lang === 'hi') ? 'कृपया इसका एक दैनिक जीवन और ग्रामीण परिवेश का व्यावहारिक उदाहरण दें।' : 'Give me an everyday practical example of this.' %>">
        🌱 <%= (lang === 'hi') ? 'एक उदाहरण दें' : 'Give me an example' %>
      </button>
      <button type="button" class="quick-prompt-action" data-prompt="<%= (lang === 'hi') ? 'कृपया इसे हिन्दी और आसान भाषा में समझाएं।' : 'Explain this in Hindi as well.' %>">
        🌐 <%= (lang === 'hi') ? 'हिन्दी में समझाओ' : 'Explain in Hindi' %>
      </button>
      <button type="button" class="quick-prompt-action" data-prompt="<%= (lang === 'hi') ? 'कृपया इस विषय का 3 मुख्य बिंदुओं में संक्षेप में सार (Summary) बताएं।' : 'Please summarize this in 3 concise bullet points.' %>">
        📝 <%= (lang === 'hi') ? 'संक्षेप में सार' : 'Summarize this' %>
      </button>
      <button type="button" class="quick-prompt-action" data-prompt="<%= (lang === 'hi') ? 'इस विषय पर मेरी समझ जांचने के लिए मुझसे 2 बहुविकल्पीय प्रश्न पूछें।' : 'Quiz me on this topic with 2 practice questions.' %>">
        ❓ <%= (lang === 'hi') ? 'मुझसे सवाल पूछो' : 'Quiz me on this topic' %>
      </button>
    </div>

    <!-- Chat Input Form -->
    <form id="chat-form" class="chat-input-bar">
      <button type="button" id="voice-mic-btn" class="mic-btn" title="Speak question using microphone" aria-label="Microphone">
        🎤
      </button>

      <input 
        type="text" 
        id="chat-input" 
        placeholder="<%= t('askQuestionPlaceholder') %>" 
        required 
        autocomplete="off"
      >

      <button type="submit" id="chat-send-btn" class="btn btn-primary" style="padding: 0.75rem 1.4rem;">
        <span><%= t('send') %></span>
        <span>➤</span>
      </button>
    </form>
  </div>
</main>

<script src="/js/voice.js"></script>
<script>
  // Simple markdown renderer for AI responses
  function renderMarkdownText(text) {
    if (!text) return '';
    return text
      .replace(/^### (.*$)/gim, '<h4 style="font-weight: 700; color: var(--primary); margin: 0.6rem 0 0.3rem;">$1</h4>')
      .replace(/^#### (.*$)/gim, '<h5 style="font-weight: 700; color: #0F172A; margin: 0.5rem 0 0.2rem;">$1</h5>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/\n/g, '<br>');
  }

  // Read Aloud Handler
  function readBubbleText(btn) {
    const parentBubble = btn.closest('.chat-bubble');
    if (!parentBubble) return;
    const textElement = parentBubble.querySelector('.bubble-text');
    const activeLang = window.EduSaarthiLanguage ? window.EduSaarthiLanguage.get() : '<%= lang || "hi" %>';
    if (textElement && window.EduVoice) {
      window.EduVoice.speak(textElement.innerText, activeLang);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');
    const micBtn = document.getElementById('voice-mic-btn');
    const chatSendBtn = document.getElementById('chat-send-btn');
    const messageHistory = [];

    // Scroll to bottom helper
    function scrollToBottom() {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // Append message to chat
    function appendMessage(sender, text, isAi = false) {
      const bubble = document.createElement('div');
      bubble.className = `chat-bubble ${sender}`;

      if (isAi) {
        bubble.innerHTML = `
          <div class="msg-header">
            <strong>EduSaarthi AI</strong>
            <div style="display: flex; gap: 0.35rem;">
              <button type="button" class="read-aloud-btn" onclick="readBubbleText(this)">
                🔊 <%= (lang === 'hi') ? 'सुनाएँ' : 'Read Aloud' %>
              </button>
              <button type="button" class="read-aloud-btn" onclick="window.EduVoice && window.EduVoice.stopSpeaking()" style="color: #DC2626;" title="Stop audio">
                ⏹ <%= (lang === 'hi') ? 'रोकें' : 'Stop' %>
              </button>
            </div>
          </div>
          <div class="bubble-text">${renderMarkdownText(text)}</div>
        `;
      } else {
        bubble.innerHTML = `
          <div class="msg-header">
            <strong><%= (lang === 'hi') ? 'विद्यार्थी (आप)' : 'Student (You)' %></strong>
          </div>
          <div class="bubble-text">${text}</div>
        `;
      }

      chatMessages.appendChild(bubble);
      scrollToBottom();
      messageHistory.push({ sender: sender === 'student' ? 'user' : 'model', text });
    }

    // Submit Chat Message
    async function sendMessage(text) {
      if (!text || !text.trim()) return;
      const query = text.trim();
      chatInput.value = '';

      // Add user message
      appendMessage('student', query, false);

      // Loading bubble
      const loadingBubble = document.createElement('div');
      loadingBubble.className = 'chat-bubble ai';
      loadingBubble.id = 'loading-bubble';
      loadingBubble.innerHTML = `<span style="opacity: 0.7;">💭 <%= (lang === 'hi') ? 'सोच रहा हूँ...' : 'Thinking...' %></span>`;
      chatMessages.appendChild(loadingBubble);
      scrollToBottom();

      chatSendBtn.disabled = true;

      const activeLang = window.EduSaarthiLanguage ? window.EduSaarthiLanguage.get() : '<%= lang || "hi" %>';

      try {
        const res = await fetch('/tutor/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: query,
            language: activeLang,
            educationLevel: '<%= (user && user.education_level) ? user.education_level : "Class 10" %>',
            history: messageHistory
          })
        });

        const loadingElem = document.getElementById('loading-bubble');
        if (loadingElem) loadingElem.remove();

        if (res.ok) {
          const data = await res.json();
          appendMessage('ai', data.reply, true);
        } else {
          appendMessage('ai', '<%= (lang === "hi") ? "एआई ट्यूटर अस्थायी रूप से व्यस्त है। कृपया पुनः प्रयास करें।" : "AI Tutor is temporarily unavailable. Please try again." %>', true);
        }
      } catch (err) {
        console.error('Chat error:', err);
        const loadingElem = document.getElementById('loading-bubble');
        if (loadingElem) loadingElem.remove();
        appendMessage('ai', '<%= (lang === "hi") ? "नेटवर्क समस्या। यदि आप ऑफ़लाइन हैं, तो सहेजे गए विषयों के सामान्य प्रश्न अभी भी उपलब्ध हैं।" : "Network connectivity issue. Please check connection." %>', true);
      } finally {
        chatSendBtn.disabled = false;
        chatInput.focus();
      }
    }

    // Quick Action Helper Prompt Buttons
    document.querySelectorAll('.quick-prompt-action').forEach(btn => {
      btn.addEventListener('click', () => {
        const prompt = btn.dataset.prompt;
        if (prompt) {
          sendMessage(prompt);
        }
      });
    });

    chatForm.addEventListener('submit', (e) => {
      e.preventDefault();
      sendMessage(chatInput.value);
    });

    // Suggested Question Chips
    document.querySelectorAll('.chip-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const query = btn.dataset.query;
        if (query) {
          sendMessage(query);
        }
      });
    });

    // Voice Microphone Interaction
    if (micBtn && window.EduVoice) {
      micBtn.addEventListener('click', () => {
        window.EduVoice.toggleListening(
          (spokenText, isFinal) => {
            chatInput.value = spokenText;
            if (isFinal) {
              setTimeout(() => {
                sendMessage(spokenText);
              }, 400);
            }
          },
          (listening) => {
            if (listening) {
              micBtn.classList.add('listening');
            } else {
              micBtn.classList.remove('listening');
            }
          }
        );
      });
    }

    // Auto-focus input
    chatInput.focus();
  });
</script>

<%- include('partials/bottom-nav', { activeTab: 'tutor' }) %>
<%- include('partials/footer') %>
