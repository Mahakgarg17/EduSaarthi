<%- include('partials/header', { pageTitle: (lang === 'hi') ? 'छात्रवृत्ति खोज' : 'Scholarship Finder' }) %>
<%- include('partials/navbar', { activeTab: 'scholarships' }) %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
  <!-- Header Section -->
  <div style="text-align: center; max-width: 720px; margin: 0 auto 2.5rem;">
    <span class="badge badge-warning" style="margin-bottom: 0.5rem; font-size: 0.8rem;">
      🎓 <%= (lang === 'hi') ? 'वित्तीय सहायता एवं अवसर' : 'Financial Aid & Growth' %>
    </span>
    <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--primary); margin-bottom: 0.5rem;">
      <%= (lang === 'hi') ? 'अपने लिए सही छात्रवृत्तियां खोजें' : 'Find Opportunities Made for You' %>
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem;">
      <%= (lang === 'hi') 
        ? 'अपनी पृष्ठभूमि, श्रेणी और राज्य के अनुसार केंद्र व राज्य सरकार की छात्रवृत्ति योजनाओं की सीधी जानकारी पाएं।' 
        : 'Filter national and state government scholarships tailored to your income, category, and educational level.' %>
    </p>

    <!-- Required Hackathon Prototype Disclaimer -->
    <div style="margin-top: 1.25rem; background: #FEF3C7; border: 1.5px solid #FCD34D; border-radius: var(--radius-md); padding: 0.75rem 1rem; font-size: 0.825rem; color: #92400E; text-align: left; display: flex; align-items: flex-start; gap: 0.5rem;">
      <span style="font-size: 1.1rem;">⚠️</span>
      <div>
        <strong>Notice:</strong> Prototype scholarship data — verify eligibility and deadlines on the official scholarship portal (<a href="https://scholarships.gov.in" target="_blank" rel="noopener" style="color: #B45309; text-decoration: underline; font-weight: 700;">scholarships.gov.in</a>) before applying.
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 320px 1fr; gap: 2rem; align-items: flex-start;">
    <!-- Left Sidebar: Eligibility Filter Form -->
    <aside class="card" style="position: sticky; top: 5.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-main);">
          <%= (lang === 'hi') ? 'पात्रता फ़िल्टर' : 'Eligibility Filter' %>
        </h3>
        <button type="button" id="fill-demo-profile" class="btn btn-sm btn-accent" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;" title="Autofill Demo Profile">
          ⚡ Demo Profile
        </button>
      </div>

      <form id="scholarship-filter-form" action="/scholarships" method="GET">
        <!-- Education Level -->
        <div class="form-group">
          <label for="education_level" class="form-label"><%= (lang === 'hi') ? 'कक्षा / स्तर' : 'Education Level' %></label>
          <select id="education_level" name="education_level" class="form-select">
            <option value="All" <%= filters.education_level === 'All' ? 'selected' : '' %>>All Levels</option>
            <option value="Class 9-10" <%= filters.education_level === 'Class 9-10' ? 'selected' : '' %>>Class 9-10 (Pre-Matric)</option>
            <option value="Class 11-12 & Higher" <%= filters.education_level === 'Class 11-12 & Higher' ? 'selected' : '' %>>Class 11-12 & Higher</option>
            <option value="Polytechnic / Diploma / B.Tech" <%= filters.education_level === 'Polytechnic / Diploma / B.Tech' ? 'selected' : '' %>>Polytechnic / Tech</option>
          </select>
        </div>

        <!-- State -->
        <div class="form-group">
          <label for="state" class="form-label"><%= (lang === 'hi') ? 'राज्य (State)' : 'State' %></label>
          <select id="state" name="state" class="form-select">
            <option value="All" <%= filters.state === 'All' ? 'selected' : '' %>>All India (National)</option>
            <option value="Jharkhand" <%= filters.state === 'Jharkhand' ? 'selected' : '' %>>Jharkhand</option>
            <option value="Bihar" <%= filters.state === 'Bihar' ? 'selected' : '' %>>Bihar</option>
            <option value="Odisha" <%= filters.state === 'Odisha' ? 'selected' : '' %>>Odisha</option>
            <option value="Madhya Pradesh" <%= filters.state === 'Madhya Pradesh' ? 'selected' : '' %>>Madhya Pradesh</option>
          </select>
        </div>

        <!-- Category -->
        <div class="form-group">
          <label for="category" class="form-label"><%= (lang === 'hi') ? 'सामाजिक श्रेणी' : 'Category' %></label>
          <select id="category" name="category" class="form-select">
            <option value="All" <%= filters.category === 'All' ? 'selected' : '' %>>All Categories</option>
            <option value="ST" <%= filters.category === 'ST' ? 'selected' : '' %>>Scheduled Tribe (ST)</option>
            <option value="SC" <%= filters.category === 'SC' ? 'selected' : '' %>>Scheduled Caste (SC)</option>
            <option value="Minority" <%= filters.category === 'Minority' ? 'selected' : '' %>>Minority</option>
          </select>
        </div>

        <!-- Annual Family Income Limit -->
        <div class="form-group">
          <label for="max_income" class="form-label"><%= (lang === 'hi') ? 'वार्षिक पारिवारिक आय सीमा' : 'Annual Family Income' %></label>
          <select id="max_income" name="max_income" class="form-select">
            <option value="">Any Income Limit</option>
            <option value="200000" <%= filters.max_income === '200000' ? 'selected' : '' %>>Up to ₹2,00,000 / yr</option>
            <option value="250000" <%= filters.max_income === '250000' ? 'selected' : '' %>>Up to ₹2,50,000 / yr</option>
            <option value="350000" <%= filters.max_income === '350000' ? 'selected' : '' %>>Up to ₹3,50,000 / yr</option>
            <option value="800000" <%= filters.max_income === '800000' ? 'selected' : '' %>>Up to ₹8,00,000 / yr</option>
          </select>
        </div>

        <!-- Gender -->
        <div class="form-group">
          <label for="gender" class="form-label"><%= (lang === 'hi') ? 'लिंग (Gender)' : 'Gender' %></label>
          <select id="gender" name="gender" class="form-select">
            <option value="All" <%= filters.gender === 'All' ? 'selected' : '' %>>All (सभी)</option>
            <option value="Female" <%= filters.gender === 'Female' ? 'selected' : '' %>>Female Only (बालिकाएं)</option>
          </select>
        </div>

        <!-- Min Percentage -->
        <div class="form-group">
          <label for="min_percentage" class="form-label"><%= (lang === 'hi') ? 'न्यूनतम प्राप्तांक %' : 'Academic Marks %' %></label>
          <input type="number" id="min_percentage" name="min_percentage" class="form-control" placeholder="उदा. 60" value="<%= filters.min_percentage %>">
        </div>

        <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary" style="flex: 1;">
            <%= (lang === 'hi') ? 'खोजें' : 'Filter' %>
          </button>
          <a href="/scholarships" class="btn btn-secondary">
            Reset
          </a>
        </div>
      </form>
    </aside>

    <!-- Right Side: Scholarship Cards List -->
    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
        <div style="font-weight: 700; color: var(--text-main); font-size: 1.1rem;">
          <%= scholarships.length %> <%= (lang === 'hi') ? 'छात्रवृत्तियां उपलब्ध' : 'Scholarships Matched' %>
        </div>
      </div>

      <% if (scholarships.length === 0) { %>
        <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
          <div style="font-size: 2.5rem; margin-bottom: 1rem;">🔍</div>
          <h3 style="font-weight: 700; margin-bottom: 0.5rem;"><%= (lang === 'hi') ? 'कोई छात्रवृत्ति मेल नहीं खाई' : 'No Matching Scholarships' %></h3>
          <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            <%= (lang === 'hi') ? 'कृपया फ़िल्टर में आय या श्रेणी को थोड़ा व्यापक बनाकर पुनः प्रयास करें।' : 'Try loosening income or category filters to explore wider opportunities.' %>
          </p>
          <a href="/scholarships" class="btn btn-primary"><%= (lang === 'hi') ? 'सभी छात्रवृत्तियां देखें' : 'View All Scholarships' %></a>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <% scholarships.forEach(s => { %>
            <article class="card" style="border-left: 5px solid #2563EB;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.75rem;">
                <div>
                  <span class="badge badge-primary" style="margin-bottom: 0.35rem;"><%= s.education_level %></span>
                  <span class="badge badge-warning"><%= s.category %></span>
                  <span class="badge badge-slate"><%= s.state %></span>
                  <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin-top: 0.4rem;">
                    <%= (lang === 'hi') ? s.name_hi : s.name %>
                  </h3>
                  <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">
                    🏛️ <%= s.provider %>
                  </div>
                </div>

                <div style="text-align: right;">
                  <div style="font-size: 1.15rem; font-weight: 800; color: #059669;">
                    <%= s.benefit_amount %>
                  </div>
                  <div style="font-size: 0.8rem; color: #DC2626; font-weight: 600; margin-top: 0.2rem;">
                    ⏳ Deadline: <%= s.deadline %>
                  </div>
                </div>
              </div>

              <p style="font-size: 0.95rem; color: #334155; line-height: 1.55; margin-bottom: 1rem;">
                <%= (lang === 'hi') ? s.description_hi : s.description %>
              </p>

              <!-- Eligibility Criteria Pill Bar -->
              <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; background: var(--surface-alt); padding: 0.75rem 1rem; border-radius: var(--radius-md); font-size: 0.825rem; margin-bottom: 1rem;">
                <div><strong>Income Limit:</strong> Up to ₹<%= s.max_income.toLocaleString('en-IN') %>/yr</div>
                <div>&bull;</div>
                <div><strong>Min Marks:</strong> <%= s.min_percentage %>%</div>
                <div>&bull;</div>
                <div><strong>Gender:</strong> <%= s.gender %></div>
              </div>

              <!-- Required Documents -->
              <% if (s.required_documents_list && s.required_documents_list.length > 0) { %>
                <div style="margin-bottom: 1.25rem;">
                  <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.4rem;">
                    <%= (lang === 'hi') ? 'आवश्यक दस्तावेज (Required Documents):' : 'Required Documents:' %>
                  </div>
                  <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                    <% s.required_documents_list.forEach(doc => { %>
                      <span class="badge badge-slate" style="font-size: 0.75rem; font-weight: 500;">📄 <%= doc %></span>
                    <% }); %>
                  </div>
                </div>
              <% } %>

              <!-- Official Link Action -->
              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 1rem;">
                <span style="font-size: 0.8rem; color: var(--text-muted);">Official National Scholarship Portal</span>
                <a href="<%= s.official_portal %>" target="_blank" rel="noopener" class="btn btn-sm btn-primary">
                  <span><%= (lang === 'hi') ? 'आधिकारिक पोर्टल पर देखें ↗' : 'Apply on Official Portal ↗' %></span>
                </a>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</main>

<script>
  // Quick 1-click Demo Profile autofill for judge testing
  document.getElementById('fill-demo-profile').addEventListener('click', () => {
    document.getElementById('state').value = 'Jharkhand';
    document.getElementById('category').value = 'ST';
    document.getElementById('max_income').value = '250000';
    document.getElementById('education_level').value = 'Class 9-10';
    document.getElementById('gender').value = 'All';
    document.getElementById('min_percentage').value = '60';
    window.showToast('Demo Student Profile loaded (Rahul: ST, Jharkhand, Class 10)', 'info');
    setTimeout(() => {
      document.getElementById('scholarship-filter-form').submit();
    }, 400);
  });
</script>

<%- include('partials/footer') %>
