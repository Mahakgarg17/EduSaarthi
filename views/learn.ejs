<%- include('partials/header', { pageTitle: (lang === 'hi') ? 'पढ़ाई एवं विषय सूची' : 'Learning Modules & Courses' }) %>
<%- include('partials/navbar', { activeTab: 'learn' }) %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
  <div style="margin-bottom: 2rem; text-align: center; max-width: 700px; margin-left: auto; margin-right: auto;">
    <h1 style="font-size: 2rem; font-weight: 800; color: var(--primary); margin-bottom: 0.5rem;">
      <%= (lang === 'hi') ? 'पाठ्यक्रम एवं विषय सूची' : 'Curriculum & Subjects' %>
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem;">
      <%= (lang === 'hi') 
        ? 'कक्षा 10 बोर्ड परीक्षा और व्यावहारिक ज्ञान के लिए विशेष रूप से तैयार किए गए संरचित पाठ।' 
        : 'Structured concept lessons tailored for Class 10 board exams and practical foundational learning.' %>
    </p>

    <!-- Category Filter Pills -->
    <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem;">
      <% categories.forEach(cat => { %>
        <a href="/learn?category=<%= cat %>" 
           class="btn btn-sm <%= (selectedCategory === cat) ? 'btn-primary' : 'btn-secondary' %>"
           style="border-radius: 9999px;">
          <%= cat %>
        </a>
      <% }); %>
    </div>
  </div>

  <!-- Courses Grid -->
  <div class="courses-grid">
    <% courses.forEach(course => { %>
      <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid <%= course.color %>;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
            <span class="badge badge-primary"><%= course.education_level %></span>
            <span class="badge badge-slate"><%= course.category %></span>
          </div>

          <h3 style="font-size: 1.3rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem;">
            <%= (lang === 'hi') ? course.title_hi : course.title %>
          </h3>

          <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.25rem;">
            <%= (lang === 'hi') ? course.description_hi : course.description %>
          </p>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; font-size: 0.85rem; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 0.75rem;">
            <span>📖 <%= course.total_lessons %> <%= (lang === 'hi') ? 'अध्याय / पाठ' : 'Lessons' %></span>
            <span style="color: #059669; font-weight: 600;">✓ Offline Ready</span>
          </div>

          <a href="/learn/<%= course.slug %>" class="btn btn-primary" style="width: 100%;">
            <%= (lang === 'hi') ? 'पाठ सूची देखें →' : 'View Course Lessons →' %>
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</main>

<%- include('partials/bottom-nav', { activeTab: 'learn' }) %>
<%- include('partials/footer') %>
