<%- include('partials/header', { pageTitle: (lang === 'hi') ? 'प्रश्नोत्तरी व टेस्ट' : 'Quizzes & Tests' }) %>
<%- include('partials/navbar', { activeTab: 'quizzes' }) %>

<div class="app-layout">
  <%- include('partials/sidebar', { activeTab: 'quizzes' }) %>

  <main class="app-content">
    <div class="content-header">
      <div>
        <h1 class="page-title">
          <span>📝</span>
          <span><%= (lang === 'hi') ? 'प्रश्नोत्तरी एवं मॉक टेस्ट' : 'Quizzes & Practice Tests' %></span>
        </h1>
        <p class="page-subtitle">
          <%= (lang === 'hi') ? 'अपनी समझ को परखें, कमज़ोर विषयों की पहचान करें और परीक्षा की तैयारी मजबूत करें।' : 'Test your conceptual understanding with quick daily challenges and subject-wise practice tests.' %>
        </p>
      </div>

      <div class="header-action-pill">
        <span class="badge badge-accent">⚡ <%= (lang === 'hi') ? 'रोज़ाना 5 प्रश्न' : 'Daily 5 Questions' %></span>
      </div>
    </div>

    <!-- Student Quiz Stats Overview -->
    <div class="stats-grid" style="margin-bottom: 2rem;">
      <div class="stat-card">
        <div class="stat-icon-wrapper" style="background-color: #EFF6FF; color: #2563EB;">📝</div>
        <div class="stat-info">
          <span class="stat-label"><%= (lang === 'hi') ? 'कुल दिए गए टेस्ट' : 'Tests Attempted' %></span>
          <h3 class="stat-value"><%= stats.totalTaken %></h3>
          <span class="stat-trend positive">✓ <%= (lang === 'hi') ? 'सक्रिय शिक्षार्थी' : 'Active Learner' %></span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon-wrapper" style="background-color: #ECFDF5; color: #059669;">🎯</div>
        <div class="stat-info">
          <span class="stat-label"><%= (lang === 'hi') ? 'औसत प्राप्तांक' : 'Average Score' %></span>
          <h3 class="stat-value"><%= stats.avgScore %>%</h3>
          <span class="stat-trend positive">↑ <%= (lang === 'hi') ? 'मजबूत समझ' : 'Strong Concept' %></span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon-wrapper" style="background-color: #FEF3C7; color: #D97706;">🏆</div>
        <div class="stat-info">
          <span class="stat-label"><%= (lang === 'hi') ? 'सर्वश्रेष्ठ प्रदर्शन' : 'Best Performance' %></span>
          <h3 class="stat-value"><%= stats.bestScore %>%</h3>
          <span class="stat-trend positive">🌟 <%= (lang === 'hi') ? 'उत्कृष्ट' : 'Outstanding' %></span>
        </div>
      </div>
    </div>

    <!-- Today's Daily Challenge Hero Card -->
    <% if (dailyChallenge) { %>
      <div class="daily-challenge-hero-card">
        <div class="challenge-badge">
          <span>🔥</span>
          <span><%= (lang === 'hi') ? 'आज की चुनौती' : "Today's Challenge" %></span>
        </div>
        <div class="challenge-body">
          <div class="challenge-info">
            <span class="category-pill"><%= dailyChallenge.category %></span>
            <h2><%= (lang === 'hi') ? dailyChallenge.title_hi : dailyChallenge.title %></h2>
            <p><%= (lang === 'hi') ? dailyChallenge.description_hi : dailyChallenge.description %></p>
            <div class="challenge-meta">
              <span>⏱️ <%= dailyChallenge.time_limit_minutes %> <%= (lang === 'hi') ? 'मिनट' : 'mins' %></span>
              <span>•</span>
              <span>❓ <%= dailyChallenge.total_questions %> <%= (lang === 'hi') ? 'बहुविकल्पीय प्रश्न' : 'Questions' %></span>
              <span>•</span>
              <span class="difficulty-tag <%= dailyChallenge.difficulty.toLowerCase() %>"><%= dailyChallenge.difficulty %></span>
            </div>
          </div>
          <div class="challenge-cta">
            <a href="/quizzes/take/<%= dailyChallenge.slug %>" class="btn btn-primary btn-lg">
              <span><%= (lang === 'hi') ? 'चुनौती शुरू करें' : 'Start Daily Challenge' %></span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Subject Quizzes Grid -->
    <div class="section-title-wrap">
      <div>
        <h3 class="section-heading"><%= (lang === 'hi') ? 'विषयवार अभ्यास टेस्ट' : 'Subject Practice Tests' %></h3>
        <p class="section-subtext"><%= (lang === 'hi') ? 'अपनी सुविधानुसार किसी भी विषय का अभ्यास करें।' : 'Select a topic to test your fundamentals and build exam confidence.' %></p>
      </div>
    </div>

    <div class="course-grid">
      <% subjectQuizzes.forEach(quiz => { %>
        <div class="card quiz-card">
          <div class="quiz-card-header">
            <div class="quiz-icon-circle"><%= quiz.icon %></div>
            <span class="category-pill"><%= quiz.category %></span>
          </div>

          <h4 class="quiz-title">
            <%= (lang === 'hi') ? quiz.title_hi : quiz.title %>
          </h4>

          <p class="quiz-desc">
            <%= (lang === 'hi') ? quiz.description_hi : quiz.description %>
          </p>

          <div class="quiz-footer-meta">
            <span class="quiz-meta-item">⏱️ <%= quiz.time_limit_minutes %>m</span>
            <span class="quiz-meta-item">❓ <%= quiz.total_questions %> Qs</span>
            <span class="difficulty-tag <%= quiz.difficulty.toLowerCase() %>"><%= quiz.difficulty %></span>
          </div>

          <div style="margin-top: 1rem;">
            <a href="/quizzes/take/<%= quiz.slug %>" class="btn btn-outline-primary btn-block">
              <span><%= (lang === 'hi') ? 'टेस्ट शुरू करें' : 'Start Quiz' %></span>
              <span>→</span>
            </a>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Recent Attempts Section -->
    <% if (recentAttempts && recentAttempts.length > 0) { %>
      <div class="section-title-wrap" style="margin-top: 3rem;">
        <div>
          <h3 class="section-heading"><%= (lang === 'hi') ? 'हालिया टेस्ट परिणाम एवं समीक्षा' : 'Recent Quiz Results & Review' %></h3>
          <p class="section-subtext"><%= (lang === 'hi') ? 'अपनी गलतियों को समझें और सही उत्तरों की व्याख्या देखें।' : 'Review your answered questions, see correct answers and explanations.' %></p>
        </div>
      </div>

      <div class="recent-results-card">
        <div class="results-table-wrap">
          <table class="results-table">
            <thead>
              <tr>
                <th><%= (lang === 'hi') ? 'टेस्ट नाम' : 'Quiz Title' %></th>
                <th><%= (lang === 'hi') ? 'विषय' : 'Subject' %></th>
                <th><%= (lang === 'hi') ? 'अंक (Score)' : 'Score' %></th>
                <th><%= (lang === 'hi') ? 'समय' : 'Time Taken' %></th>
                <th><%= (lang === 'hi') ? 'स्थिति' : 'Action' %></th>
              </tr>
            </thead>
            <tbody>
              <% recentAttempts.forEach(att => { 
                const pct = Math.round((att.score / att.total_questions) * 100);
              %>
                <tr>
                  <td>
                    <div style="font-weight: 600; color: var(--text-main);">
                      <%= att.icon || '📝' %> <%= (lang === 'hi') ? att.quiz_title_hi : att.quiz_title %>
                    </div>
                    <span style="font-size: 0.75rem; color: var(--text-muted);"><%= new Date(att.created_at).toLocaleDateString() %></span>
                  </td>
                  <td>
                    <span class="badge badge-slate"><%= att.category %></span>
                  </td>
                  <td>
                    <span class="score-pill <%= pct >= 80 ? 'high' : (pct >= 50 ? 'med' : 'low') %>">
                      <%= att.score %>/<%= att.total_questions %> (<%= pct %>%)
                    </span>
                  </td>
                  <td style="color: var(--text-muted); font-size: 0.85rem;">
                    <%= att.time_taken_seconds %>s
                  </td>
                  <td>
                    <a href="/quizzes/results/<%= att.id %>" class="btn btn-sm btn-secondary">
                      🔍 <%= (lang === 'hi') ? 'उत्तर समीक्षा' : 'Review Answers' %>
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>
</div>

<%- include('partials/bottom-nav', { activeTab: 'quizzes' }) %>
<%- include('partials/footer') %>
